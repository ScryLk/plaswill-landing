# Copy to deploy/.env; keep disabled until staging and privacy review pass.
POSTHOG_ENABLED=false
# Public ingestion token (phc_...), NEVER a personal API key (phx_...).
POSTHOG_PROJECT_TOKEN=
# Match project region: https://us.i.posthog.com OR https://eu.i.posthog.com
POSTHOG_INGESTION_HOST=
POSTHOG_SITE_HOST=site.plaswill.tech
POSTHOG_ENVIRONMENT=production
